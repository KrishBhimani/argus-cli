---
import Default from '../layouts/Default.astro';
---
<Default title="Argus — Settings">
  <h2>Settings</h2>
  <div class="grid-2">
    <div>
      <div class="card" id="search-card">
        <h3>Search indexing</h3>
        <p style="color:var(--text-1);font-size:0.85rem;margin-top:0;">
          Index every assistant response, your replies, and tool output for full-text
          search. 100% local — SQLite FTS5, no embeddings, no API calls. Costs disk space
          (~0.5 MB per session on average), so it's opt-in.
        </p>

        <div id="search-status-line" style="display:flex;align-items:center;gap:0.6rem;
              padding:0.7rem 0;border-top:1px solid var(--border);margin-top:0.6rem;">
          <span class="skel" style="width:8em;height:1em;"></span>
        </div>

        <div id="search-actions" style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-top:0.4rem;"></div>
        <div id="search-progress" style="display:none;margin-top:0.6rem;color:var(--text-2);font-size:0.82rem;"></div>
      </div>

      <div class="card">
        <h3>Pricing</h3>
        <p>Pricing table version: <code id="pv">…</code></p>
        <p style="color:var(--text-1);font-size:0.85rem;">To refresh from LiteLLM, run in terminal:</p>
        <pre>argus pricing refresh</pre>
      </div>
      <div class="card">
        <h3>Export data</h3>
        <p style="color:var(--text-1);font-size:0.85rem;">All session metadata. No prompts, responses, or code are stored.</p>
        <p>
          <a href="/api/export.json" download class="button-link"><button>Download JSON</button></a>
          &nbsp;
          <a href="/api/export.csv" download class="button-link"><button>Download CSV</button></a>
        </p>
      </div>
      <div class="card">
        <h3>Wipe local data</h3>
        <p style="color:var(--text-1);font-size:0.85rem;">Delete <code>~/.argus/</code> from disk. Cannot be undone — must run from terminal:</p>
        <pre>argus wipe</pre>
      </div>
    </div>
    <div>
      <div class="card">
        <h3>Ingest status</h3>
        <div id="status" style="font-size:0.85rem;"><span class="skel" style="width:8em;"></span></div>
      </div>
      <div class="card">
        <h3>Parse errors</h3>
        <p id="err-count" style="color:var(--text-2);font-size:0.85rem;margin-top:0;">…</p>
        <div id="errs" style="max-height:420px;overflow-y:auto;overflow-x:hidden;"></div>
      </div>
    </div>
  </div>

  <script>
    import { api } from '../scripts/api';
    import { escapeHtml } from '../scripts/format';

    const $ = (s: string) => document.querySelector(s) as HTMLElement;

    // Convert raw key like "foregroundComplete" → "foreground complete"
    function humanKey(k: string): string {
      return k.replace(/([A-Z])/g, ' $1').replace(/_/g, ' ').toLowerCase().trim();
    }

    // Render a value with light type-aware formatting. Strings get a
    // monospace tone; booleans become Yes/No with a color; numbers get
    // tabular-num alignment.
    function renderValue(v: unknown): string {
      if (typeof v === 'boolean') {
        return `<span style="color:${v ? 'var(--good)' : 'var(--text-2)'};">${v ? 'yes' : 'no'}</span>`;
      }
      if (typeof v === 'number') {
        return `<span style="font-variant-numeric:tabular-nums;color:var(--text-0);">${v.toLocaleString()}</span>`;
      }
      if (v == null) return `<span style="color:var(--text-2);">—</span>`;
      if (typeof v === 'object') {
        // Nested object (rare for status) — fall back to compact JSON
        return `<code style="font-size:0.78rem;">${escapeHtml(JSON.stringify(v))}</code>`;
      }
      return escapeHtml(String(v));
    }

    // Render the ingest status as a clean key/value list instead of
    // dumping the raw JSON in a <pre>. The previous version produced a
    // wide, indented blob that the user had to scroll horizontally.
    function renderStatus(s: Record<string, unknown>): string {
      const rows = Object.entries(s).map(([k, v]) => `
        <div style="display:flex;justify-content:space-between;gap:1rem;padding:0.4rem 0;border-top:1px solid var(--border);">
          <span style="color:var(--text-2);text-transform:uppercase;letter-spacing:0.05em;font-size:0.72rem;">${escapeHtml(humanKey(k))}</span>
          <span>${renderValue(v)}</span>
        </div>
      `).join('');
      return rows;
    }

    // Last path segment, e.g. "...\\xyz.jsonl" → "xyz.jsonl". Handles
    // both POSIX and Windows separators since session files on disk
    // use backslashes on Windows.
    function basename(p: string): string {
      const parts = p.split(/[\\/]/);
      return parts[parts.length - 1] || p;
    }

    // Truncate a long file path to something like ".../parent/file.jsonl".
    function shortPath(p: string, max = 70): string {
      if (p.length <= max) return p;
      const parts = p.split(/[\\/]/);
      if (parts.length <= 3) return p;
      return '.../' + parts.slice(-3).join('/');
    }

    // The parse-error reason field comes from zod as a JSON-stringified
    // array of issue objects. Pretty-printing it inline saves the user
    // from grepping through escaped newlines.
    function prettyReason(raw: string): string {
      try {
        const issues = JSON.parse(raw);
        if (Array.isArray(issues) && issues.length > 0) {
          return issues.slice(0, 3).map((i: any) => {
            const path = Array.isArray(i.path) && i.path.length ? ` at ${i.path.join('.')}` : '';
            if (i.code === 'invalid_type') {
              return `expected ${i.expected}, received ${i.received}${path}`;
            }
            return `${i.message || i.code}${path}`;
          }).join('; ') + (issues.length > 3 ? ` (+${issues.length - 3} more)` : '');
        }
      } catch { /* not JSON; fall through */ }
      // Collapse the whitespace ruin from zod's pretty-printed JSON,
      // then truncate. Loses some detail but it's better than a wall.
      return raw.replace(/\s+/g, ' ').slice(0, 240);
    }

    // One error → one structured block. The raw line is hidden behind a
    // <details> disclosure so the panel stays scannable; click to expand.
    function renderError(err: any): string {
      const file = err.file ?? 'unknown';
      const name = basename(file);
      const path = shortPath(file);
      const reason = prettyReason(err.reason ?? '');
      const raw = err.raw_line_truncated ?? '';
      const offset = typeof err.byte_offset === 'number' && err.byte_offset >= 0
        ? `offset ${err.byte_offset.toLocaleString()}`
        : '';
      return `
        <div style="padding:0.7rem 0;border-bottom:1px solid var(--border);word-break:break-word;overflow-wrap:anywhere;">
          <div style="display:flex;justify-content:space-between;gap:0.6rem;align-items:baseline;flex-wrap:wrap;">
            <code style="color:var(--accent);background:none;padding:0;font-size:0.84rem;">${escapeHtml(name)}</code>
            <span style="color:var(--text-2);font-size:0.72rem;font-variant-numeric:tabular-nums;">${escapeHtml(offset)}</span>
          </div>
          <div style="color:var(--text-2);font-size:0.7rem;margin-top:0.1rem;" title="${escapeHtml(file)}">${escapeHtml(path)}</div>
          <div style="color:var(--text-0);font-size:0.82rem;margin-top:0.4rem;">${escapeHtml(reason)}</div>
          ${raw ? `
            <details style="margin-top:0.35rem;">
              <summary style="cursor:pointer;color:var(--text-2);font-size:0.76rem;list-style:none;">▸ raw line</summary>
              <pre style="margin:0.3rem 0 0;background:var(--bg-2);padding:0.5rem 0.7rem;border-radius:4px;font-size:0.72rem;white-space:pre-wrap;word-break:break-all;max-height:160px;overflow-y:auto;">${escapeHtml(raw)}</pre>
            </details>` : ''}
        </div>
      `;
    }

    async function load() {
      const [p, e, s] = await Promise.all([
        api.pricing(),
        api.parseErrors(),
        fetch('/api/ingest/status').then(r => r.json()),
      ]);
      $('#pv').textContent = p.version;
      $('#status').innerHTML = renderStatus(s);
      $('#err-count').textContent = e.errors.length === 0
        ? 'No parse errors recorded. Healthy.'
        : `${e.errors.length} recent parse error${e.errors.length === 1 ? '' : 's'}.`;
      $('#errs').innerHTML = e.errors.length === 0 ? '' : e.errors.map(renderError).join('');
    }

    function pillBadge(label: string, color: string): string {
      return `<span style="display:inline-flex;align-items:center;gap:0.35em;
        padding:0.15em 0.6em;border-radius:999px;background:${color}22;color:${color};
        font-size:0.78rem;font-weight:500;">
        <span style="width:6px;height:6px;border-radius:50%;background:${color};"></span>
        ${label}</span>`;
    }

    async function loadSearchStatus() {
      let s;
      try { s = await api.searchIndexStatus(); } catch { return; }

      const statusLine = $('#search-status-line');
      const actions = $('#search-actions');
      const progress = $('#search-progress');

      const badge = s.enabled
        ? pillBadge('Enabled', '#7ee787')
        : pillBadge('Disabled', '#6b7585');
      const statsText = s.segment_count > 0
        ? `${s.segment_count.toLocaleString()} segments across ${s.indexed_sessions} session${s.indexed_sessions === 1 ? '' : 's'}`
        : 'no data indexed yet';

      statusLine.innerHTML = `${badge}<span style="color:var(--text-2);font-size:0.85rem;">${statsText}</span>`;

      // Backfill progress takes precedence over the stats text — when one
      // is running, show it inline so the user sees what the "Enable"
      // click is doing.
      if (s.backfill.in_progress) {
        progress.style.display = '';
        progress.textContent = `Indexing… ${s.backfill.processed}/${s.backfill.total} sessions`;
      } else {
        progress.style.display = 'none';
      }

      // Action buttons reflect current state. Buttons that are
      // pointless in the current state are simply omitted instead of
      // disabled — fewer affordances to mis-click.
      const buttons: string[] = [];
      if (!s.enabled) {
        buttons.push(`<button id="btn-enable" style="border-color:var(--accent);color:var(--accent);">Enable indexing</button>`);
      } else {
        buttons.push(`<button id="btn-disable">Disable indexing</button>`);
      }
      if (s.segment_count > 0) {
        buttons.push(`<button id="btn-clear" style="border-color:var(--bad);color:var(--bad);">Clear indexed data</button>`);
      }
      actions.innerHTML = buttons.join('');

      const enable = document.getElementById('btn-enable');
      if (enable) enable.addEventListener('click', async () => {
        enable.setAttribute('disabled', 'true');
        enable.textContent = 'Enabling…';
        await api.searchIndexEnable();
        await loadSearchStatus();
      });

      const disable = document.getElementById('btn-disable');
      if (disable) disable.addEventListener('click', async () => {
        if (!confirm('Stop indexing new sessions? Existing indexed data stays on disk and can be searched again if you re-enable.')) return;
        await api.searchIndexDisable();
        await loadSearchStatus();
      });

      const clear = document.getElementById('btn-clear');
      if (clear) clear.addEventListener('click', async () => {
        if (!confirm(`Delete all ${s.segment_count.toLocaleString()} indexed segments and disable indexing? This cannot be undone — re-enabling will require re-indexing from your sessions.`)) return;
        const r = await api.searchIndexClear();
        await loadSearchStatus();
        // Surface how much was actually reclaimed on disk so users see
        // VACUUM ran and shrunk the file. Pure DELETE without VACUUM
        // would leave the file size unchanged.
        if (typeof r?.freed_bytes === 'number') {
          const fmt = (n: number) => n >= 1024 * 1024 ? (n / 1024 / 1024).toFixed(1) + ' MB'
            : n >= 1024 ? (n / 1024).toFixed(1) + ' KB' : n + ' B';
          $('#search-progress').style.display = '';
          $('#search-progress').innerHTML =
            `Cleared. Freed <strong style="color:var(--text-0);">${fmt(r.freed_bytes)}</strong> on disk.`;
          // Auto-hide the toast after a few seconds so the row doesn't
          // get stuck showing it forever.
          setTimeout(() => { $('#search-progress').style.display = 'none'; }, 6000);
        }
      });
    }

    load();
    loadSearchStatus();
    // While a backfill is running, refresh the status line every 2s so
    // the progress text stays current. We can't tell up front whether
    // one is in progress, so always poll cheaply.
    setInterval(loadSearchStatus, 2000);
  </script>
</Default>
