---
import Default from '../layouts/Default.astro';
---

<Default title="Argus — Workflow run">
  <div id="wf-head"></div>
  <div id="wf-plan" class="card"></div>
  <div id="wf-swim" class="card wf-swim-card"></div>
  <div class="wf-split">
    <div id="wf-cost" class="card"></div>
    <div id="wf-agent" class="card"></div>
  </div>
  <details id="wf-script-box" class="card" style="display:none;">
    <summary>orchestration script</summary>
    <pre id="wf-script">loading…</pre>
  </details>
</Default>

<script>
  import { api } from '../scripts/api';
  import type { WorkflowAgentDetail } from '../scripts/api';
  import { escapeHtml, usd, tok, num } from '../scripts/format';
  import { renderSwimlane, phaseColor } from '../scripts/swimlane';

  const id = new URLSearchParams(location.search).get('id');
  const head = document.getElementById('wf-head')!;
  const plan = document.getElementById('wf-plan')!;
  const swim = document.getElementById('wf-swim')!;
  const cost = document.getElementById('wf-cost')!;
  const panel = document.getElementById('wf-agent')!;
  const scriptBox = document.getElementById('wf-script-box') as HTMLDetailsElement;

  const fmtDur = (msv: number) => {
    const s = Math.round(msv / 1000);
    if (s < 60) return s + 's';
    if (s < 3600) return Math.floor(s / 60) + 'm ' + (s % 60) + 's';
    return Math.floor(s / 3600) + 'h ' + Math.floor((s % 3600) / 60) + 'm';
  };

  function renderAgent(a: WorkflowAgentDetail) {
    // Every string below is model-authored. escapeHtml on all of them.
    const tools = a.tools.length
      ? a.tools.map(t => `${escapeHtml(t.name)} ${t.count}${t.errors ? ` <span class="bad">(${t.errors} err)</span>` : ''}`).join(' &middot; ')
      : '<span class="dim">no tool calls</span>';
    const stats = a.linked
      ? `${tok(a.total_tokens ?? 0)} tokens &middot; ${usd(a.cost_usd)} &middot; ${num(a.tool_calls)} tool calls &middot; ${num(a.errors)} err`
      : '<span class="dim">no session row — tokens and cost unavailable</span>';
    panel.innerHTML = `
      <div class="wf-agent-head">
        <span class="wf-band-dot" style="background:${phaseColor(a.phase_index)}"></span>
        <strong>${escapeHtml(a.label || a.agent_id)}</strong>
        <span class="dim">${escapeHtml(a.phase_title)} &middot; #${a.seq} &middot; ${escapeHtml(a.model)}</span>
      </div>
      <p class="dim">queued ${fmtDur(a.queue_wait_ms)} &middot; ran ${fmtDur(a.duration_ms)}${a.linked ? ` &middot; ${num(a.turns ?? 0)} turns` : ''}</p>
      <p>${stats}</p>
      <p>${tools}</p>
      <h4>Prompt</h4>
      <pre class="wf-pre">${escapeHtml(a.prompt_preview) || '<span class="dim">not available</span>'}</pre>
      <h4>Result</h4>
      <pre class="wf-pre">${escapeHtml(a.result_preview) || '<span class="dim">not available</span>'}</pre>
      ${a.linked ? `<a href="/session?id=${encodeURIComponent(a.sub_session_id)}">open full transcript &rarr;</a>` : ''}`;
  }

  (async () => {
    if (!id) { head.innerHTML = '<p class="empty">No run id.</p>'; return; }
    const data = await api.workflow(id);
    if (!data) { head.innerHTML = '<p class="empty">Workflow run not found.</p>'; return; }
    const { run, agents } = data;

    head.innerHTML = `
      <h1 class="page-title">${escapeHtml(run.name || run.run_id)}</h1>
      <p class="page-sub">${escapeHtml(run.summary)}</p>
      <p class="dim"><code>${escapeHtml(run.run_id)}</code> &middot;
         <a href="/session?id=${encodeURIComponent(run.session_id)}">in session &rarr;</a></p>
      <div class="wf-stats">
        <div><b>${num(run.agent_count)}</b><span>agents</span></div>
        <div><b>${fmtDur(run.duration_ms)}</b><span>wall clock</span></div>
        <div><b>${usd(run.cost_usd)}</b><span>est. cost</span></div>
        <div><b>${num(run.tool_calls)}</b><span>tool calls</span></div>
        <div><b>${num(run.phase_count)}</b><span>phases</span></div>
        <div><b class="${run.error_agents ? 'bad' : ''}">${num(run.error_agents)}</b><span>failed</span></div>
      </div>`;

    // Plan vs actual: declared phases against what really ran.
    const actual = new Map<string, number>();
    for (const a of agents) actual.set(a.phase_title, (actual.get(a.phase_title) ?? 0) + 1);
    const declared = run.phases.map(p => p.title);
    const seen = new Set(declared);
    const extra = [...actual.keys()].filter(t => t && !seen.has(t));
    const chips = [...declared, ...extra].map(t => {
      const n = actual.get(t) ?? 0;
      return `<span class="wf-chip"><b>${escapeHtml(t)}</b> ${n}${declared.includes(t) ? '' : ' &#9889;'}</span>`;
    }).join('');
    plan.innerHTML = `<h3>Plan vs actual</h3><div class="wf-chips">${chips}</div>${
      run.logs.length
        ? `<ul class="wf-logs">${run.logs.map(l => `<li>${escapeHtml(l)}</li>`).join('')}</ul>`
        : ''}`;

    renderSwimlane(swim, agents, renderAgent);

    // Cost rollup by phase, from argus's own numbers.
    const byPhase = new Map<string, { c: number; i: number }>();
    for (const a of agents) {
      const cur = byPhase.get(a.phase_title) ?? { c: 0, i: a.phase_index };
      cur.c += a.cost_usd ?? 0;
      byPhase.set(a.phase_title, cur);
    }
    const maxC = Math.max(0.0001, ...[...byPhase.values()].map(v => v.c));
    const phaseBars = [...byPhase.entries()]
      .sort((x, y) => y[1].c - x[1].c)
      .map(([t, v]) => `<div class="wf-bar-row">
        <span>${escapeHtml(t)}</span>
        <span class="wf-bar"><i style="width:${((v.c / maxC) * 100).toFixed(1)}%;background:${phaseColor(v.i)}"></i></span>
        <span class="num">${usd(v.c)}</span></div>`).join('');
    const top = [...agents]
      .filter(a => a.cost_usd != null)
      .sort((x, y) => (y.cost_usd ?? 0) - (x.cost_usd ?? 0))
      .slice(0, 5)
      .map(a => `<div class="wf-bar-row"><span>${escapeHtml(a.label || a.agent_id)}</span>
        <span></span><span class="num">${usd(a.cost_usd)}</span></div>`).join('');
    cost.innerHTML = `<h3>Where the money went</h3>${phaseBars}
      <h4>Top spend</h4>${top || '<p class="dim">no linked sessions</p>'}`;

    if (run.has_script) {
      scriptBox.style.display = '';
      scriptBox.addEventListener('toggle', async () => {
        if (!scriptBox.open) return;
        const el = document.getElementById('wf-script')!;
        if (el.dataset.loaded) return;
        // textContent, never innerHTML: this is model-authored JS.
        el.textContent = (await api.workflowScript(id)) ?? 'unavailable';
        el.dataset.loaded = '1';
      }, { once: false });
    }
  })();
</script>
