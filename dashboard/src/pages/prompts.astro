---
import Default from '../layouts/Default.astro';
---
<Default title="Argus — Search">
  <h2>Search</h2>
  <p style="color:var(--text-2);font-size:0.85rem;margin:-0.4rem 0 1rem;">
    Searches every prompt you've typed <em>and</em> every transcript Claude wrote
    (assistant text, your replies, tool output). 100% local — SQLite FTS5, no
    embeddings, no API calls.
  </p>

  <!--
    Banner shown when search indexing is off. Hits /api/search-index/status
    on load and inserts itself only when needed, so the page stays clean
    for the common (enabled) case. Includes an inline Enable button so
    users don't have to bounce to Settings just to flip the flag back on.
  -->
  <div id="search-disabled-banner" style="display:none;
    background:var(--bg-1);border:1px solid var(--warn);border-left-width:4px;
    border-radius:6px;padding:0.85rem 1.05rem;margin-bottom:1rem;
    color:var(--text-1);font-size:0.88rem;
    align-items:center;gap:0.8rem;flex-wrap:wrap;">
    <div style="flex:1;min-width:240px;">
      <strong style="color:var(--warn);">Search is off.</strong>
      Argus isn't surfacing any of your prompt or transcript history right now.
      Enable to index your sessions for full-text search — 100% local, no API calls.
    </div>
    <button id="banner-enable" style="border-color:var(--accent);color:var(--accent);flex-shrink:0;">
      Enable search
    </button>
  </div>

  <div class="card" style="margin-bottom:1rem;display:flex;gap:0.6rem;align-items:center;flex-wrap:wrap;">
    <input id="q" type="text" placeholder="Search…"
           style="flex:1;min-width:240px;background:var(--bg-2);color:var(--text-0);
                  border:1px solid var(--border);border-radius:6px;padding:0.5rem 0.8rem;
                  font-size:0.95rem;font-family:inherit;outline:none;" />
    <select id="proj">
      <option value="">All projects</option>
    </select>
  </div>

  <div class="card" style="margin-bottom:1rem;display:flex;gap:0.6rem;align-items:center;flex-wrap:wrap;font-size:0.82rem;">
    <span style="color:var(--text-2);">Show:</span>
    <label class="role-toggle"><input type="checkbox" data-role="prompt"    checked /> Your prompts</label>
    <label class="role-toggle"><input type="checkbox" data-role="user"      checked /> Your replies</label>
    <label class="role-toggle"><input type="checkbox" data-role="assistant" checked /> Claude</label>
    <label class="role-toggle"><input type="checkbox" data-role="thinking"          /> Thinking</label>
    <label class="role-toggle"><input type="checkbox" data-role="tool_result"       /> Tool output</label>
    <span style="margin-left:auto;color:var(--text-2);">
      <label style="cursor:pointer;"><input id="slash" type="checkbox" /> Include slash commands</label>
    </span>
  </div>

  <div id="totals" class="card" style="margin-bottom:1rem;display:none;
    color:var(--text-2);font-size:0.82rem;text-align:center;padding:0.6rem 1rem;"></div>

  <div id="results"></div>

  <!--
    is:global is intentional. We render the result list with innerHTML, which
    bypasses Astro's component-scoped class hashing — without is:global the
    selectors below would never match the injected DOM. Class names are
    namespaced (s-…) to keep them out of the global stylesheet's general
    pool.
  -->
  <style is:global>
    .role-toggle {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      cursor: pointer;
      color: var(--text-1);
    }

    .s-session-card {
      background: var(--bg-1);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 0;
      margin-bottom: 0.85rem;
      overflow: hidden;
    }
    .s-session-card.is-unlinked { border-style: dashed; }
    .s-session-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      padding: 0.7rem 1rem;
      background: var(--bg-2);
      border-bottom: 1px solid var(--border);
      font-size: 0.82rem;
      flex-wrap: wrap;
    }
    .s-session-head .proj {
      font-family: 'SF Mono', Consolas, monospace;
      color: var(--text-0);
      font-weight: 500;
    }
    .s-session-head .meta {
      color: var(--text-2);
      font-size: 0.75rem;
    }
    .s-session-head .open {
      color: var(--accent);
      font-size: 0.82rem;
      flex-shrink: 0;
    }
    .s-session-head .count {
      display: inline-block;
      background: var(--accent-dim);
      color: var(--accent);
      padding: 0.05em 0.55em;
      border-radius: 4px;
      font-size: 0.72rem;
      font-weight: 500;
      margin-left: 0.5rem;
    }

    .s-seg-list { padding: 0.4rem 0.4rem 0.6rem; }
    .s-seg {
      display: grid;
      grid-template-columns: max-content 1fr;
      gap: 0.7rem;
      padding: 0.55rem 0.7rem;
      border-radius: 6px;
      align-items: start;
    }
    .s-seg + .s-seg { border-top: 1px solid var(--border); }
    .s-seg:hover { background: rgba(255,255,255,0.015); }
    .s-seg-role-col {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
      align-items: flex-start;
      padding-top: 0.1rem;
      min-width: 92px;
    }
    .s-seg-snippet {
      font-size: 0.88rem;
      color: var(--text-0);
      white-space: pre-wrap;
      word-break: break-word;
      line-height: 1.45;
      overflow-wrap: anywhere;
    }
    .s-seg-snippet mark {
      background: rgba(240, 136, 62, 0.28);
      color: var(--text-0);
      padding: 0 1px;
      border-radius: 2px;
    }
    .s-seg-time { color: var(--text-2); font-size: 0.7rem; }
    .s-pill {
      display: inline-block;
      padding: 0.05em 0.55em;
      border-radius: 4px;
      font-size: 0.7rem;
      font-weight: 500;
      letter-spacing: 0.02em;
      white-space: nowrap;
    }
    .s-pill.role-prompt      { background: rgba(240,136,62,0.18); color: var(--accent); }
    .s-pill.role-user        { background: rgba(126,231,135,0.16); color: var(--good); }
    .s-pill.role-assistant   { background: rgba(88,166,255,0.16); color: var(--codex); }
    .s-pill.role-thinking    { background: rgba(188,140,255,0.16); color: #bc8cff; }
    .s-pill.role-tool_result { background: var(--bg-2); color: var(--text-2); }

    .s-pasted-tag {
      display: inline-block;
      background: var(--bg-2);
      color: var(--text-2);
      padding: 0.05em 0.5em;
      border-radius: 4px;
      font-size: 0.68rem;
      margin-top: 0.2rem;
    }
  </style>

  <script>
    import { api } from '../scripts/api';
    import { ago, escapeHtml } from '../scripts/format';

    const $ = (s: string) => document.querySelector(s) as HTMLElement;
    const $$ = (s: string) => Array.from(document.querySelectorAll(s)) as HTMLElement[];
    const qInput = $('#q') as HTMLInputElement;
    const projSelect = $('#proj') as HTMLSelectElement;
    const slashCheckbox = $('#slash') as HTMLInputElement;

    function projectBasename(p: string | null): string {
      if (!p) return '—';
      const parts = p.split('/');
      return parts[parts.length - 1] || p;
    }

    function bytesHuman(n: number): string {
      if (n < 1024) return n + ' B';
      if (n < 1024 * 1024) return (n / 1024).toFixed(1) + ' KB';
      return (n / 1024 / 1024).toFixed(1) + ' MB';
    }

    function safeSnippet(s: string): string {
      const open = '\x00MK_OPEN\x00';
      const close = '\x00MK_CLOSE\x00';
      const stripped = s.replace(/<mark>/g, open).replace(/<\/mark>/g, close);
      return escapeHtml(stripped).replace(new RegExp(open, 'g'), '<mark>').replace(new RegExp(close, 'g'), '</mark>');
    }
    function roleLabel(role: string): string {
      switch (role) {
        case 'prompt':      return 'you typed';
        case 'user':        return 'you said';
        case 'assistant':   return 'claude said';
        case 'thinking':    return 'thinking';
        case 'tool_result': return 'tool output';
        default:            return role;
      }
    }

    function selectedRoles(): string[] {
      return $$('.role-toggle input').filter(i => (i as HTMLInputElement).checked)
        .map(i => (i as HTMLInputElement).dataset.role!);
    }

    type Result = {
      kind: 'prompt' | 'transcript';
      role: string;
      timestamp_ms: number;
      project_path: string | null;
      text: string;
      snippet: string;
      pasted_chars: number;
      session_id: string | null;
    };

    type Group = {
      session_id: string | null;
      project_path: string | null;
      latest_ms: number;
      earliest_ms: number;
      hits: Result[];
    };

    // Group results by session_id so the UI shows one card per conversation
    // with all its matching segments nested inside, instead of a flat list
    // where the same session repeats over and over.
    function groupBySession(results: Result[]): Group[] {
      const map = new Map<string, Group>();
      for (const r of results) {
        // Unlinked prompts (no session match) collapse into a single
        // "Unlinked" pseudo-group keyed by project so they aren't all
        // smeared into one. Use a synthetic key that can't collide with
        // a real session_id.
        const key = r.session_id ?? `__unlinked__:${r.project_path ?? '_'}`;
        let g = map.get(key);
        if (!g) {
          g = {
            session_id: r.session_id,
            project_path: r.project_path,
            latest_ms: r.timestamp_ms,
            earliest_ms: r.timestamp_ms,
            hits: [],
          };
          map.set(key, g);
        }
        g.hits.push(r);
        if (r.timestamp_ms > g.latest_ms) g.latest_ms = r.timestamp_ms;
        if (r.timestamp_ms < g.earliest_ms) g.earliest_ms = r.timestamp_ms;
      }
      // Within each group, keep chronological order so a reader can scan
      // top-to-bottom and follow the conversation.
      for (const g of map.values()) {
        g.hits.sort((a, b) => a.timestamp_ms - b.timestamp_ms);
      }
      // Across groups, most-recently-touched session first.
      return [...map.values()].sort((a, b) => b.latest_ms - a.latest_ms);
    }

    function renderGroup(g: Group, q: string): string {
      const proj = escapeHtml(projectBasename(g.project_path));
      const when = g.latest_ms ? ago(new Date(g.latest_ms).toISOString()) : '';
      const isUnlinked = !g.session_id;
      const openHref = g.session_id
        ? `/session?id=${encodeURIComponent(g.session_id)}${q ? '&q=' + encodeURIComponent(q) : ''}`
        : null;

      const head = `
        <div class="s-session-head">
          <div>
            <span class="proj">${proj}</span>
            <span class="count">${g.hits.length} match${g.hits.length === 1 ? '' : 'es'}</span>
            <span class="meta" style="display:block;margin-top:0.15rem;">${when}${isUnlinked ? ' · no linked session' : ''}</span>
          </div>
          ${openHref ? `<a class="open" href="${openHref}">Open session →</a>` : ''}
        </div>`;

      const segs = g.hits.map(h => {
        const ts = h.timestamp_ms ? new Date(h.timestamp_ms).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : '';
        return `
          <div class="s-seg">
            <div class="s-seg-role-col">
              <span class="s-pill role-${h.role}">${roleLabel(h.role)}</span>
              <span class="s-seg-time">${ts}</span>
              ${h.pasted_chars > 0 ? `<span class="s-pasted-tag">+${bytesHuman(h.pasted_chars)} pasted</span>` : ''}
            </div>
            <div class="s-seg-snippet">${safeSnippet(h.snippet)}</div>
          </div>`;
      }).join('');

      return `<div class="s-session-card${isUnlinked ? ' is-unlinked' : ''}">${head}<div class="s-seg-list">${segs}</div></div>`;
    }

    function renderResults(d: { total: number; prompt_total: number; transcript_total: number; results: Result[] }) {
      const totals = $('#totals');
      const q = qInput.value.trim();
      if (q) {
        totals.style.display = '';
        const groups = groupBySession(d.results);
        const sessionCount = groups.filter(g => g.session_id).length;
        totals.innerHTML = `${d.total.toLocaleString()} matches across ${sessionCount} session${sessionCount === 1 ? '' : 's'} · `
          + `<span style="color:var(--accent);">${d.prompt_total.toLocaleString()}</span> in your prompts, `
          + `<span style="color:var(--codex);">${d.transcript_total.toLocaleString()}</span> in transcripts`;
      } else {
        totals.style.display = 'none';
      }

      if (d.results.length === 0) {
        $('#results').innerHTML = q
          ? '<div class="empty">No matches.</div>'
          : '<div class="empty">Type something to search across every prompt and every transcript.</div>';
        return;
      }
      const groups = groupBySession(d.results);
      $('#results').innerHTML = groups.map(g => renderGroup(g, q)).join('');
    }

    async function loadProjects() {
      try {
        const { projects } = await api.promptProjects();
        for (const p of projects) {
          const opt = document.createElement('option');
          opt.value = p;
          opt.textContent = projectBasename(p);
          projSelect.appendChild(opt);
        }
      } catch { /* ignore */ }
    }

    // Show / hide the "indexing is off" banner based on the persisted
    // flag. Wires up the inline Enable button so the user can flip it
    // back on without leaving the page.
    async function loadIndexBanner() {
      try {
        const s = await api.searchIndexStatus();
        const banner = document.getElementById('search-disabled-banner')!;
        banner.style.display = s.enabled ? 'none' : 'flex';

        const enableBtn = document.getElementById('banner-enable');
        if (enableBtn && !s.enabled) {
          enableBtn.onclick = async () => {
            enableBtn.setAttribute('disabled', 'true');
            enableBtn.textContent = 'Enabling…';
            await api.searchIndexEnable();
            // Hide the banner immediately; refresh search so the user
            // sees results populate as the backfill progresses.
            banner.style.display = 'none';
            await refresh();
            // Reload projects since prompt_projects was returning [] while off.
            projSelect.querySelectorAll('option:not([value=""])').forEach(o => o.remove());
            await loadProjects();
          };
        }
      } catch { /* ignore */ }
    }

    let debounceTimer: any;
    async function refresh() {
      const q = qInput.value.trim();
      const project = projSelect.value || undefined;
      const includeSlash = slashCheckbox.checked;
      const roles = selectedRoles();

      try {
        // Higher limit when we're going to group, since most matches will
        // collapse into a few sessions anyway.
        const d = await api.search({ q, limit: 200, project, includeSlash, roles });
        renderResults(d);
      } catch {
        $('#results').innerHTML = '<div class="empty">Search failed.</div>';
      }
    }

    function refreshDebounced() {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(refresh, 150);
    }

    qInput.addEventListener('input', refreshDebounced);
    projSelect.addEventListener('change', refresh);
    slashCheckbox.addEventListener('change', refresh);
    $$('.role-toggle input').forEach(el => el.addEventListener('change', refresh));

    loadProjects();
    loadIndexBanner();
    refresh();
  </script>
</Default>
