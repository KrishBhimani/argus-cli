---
const { title = 'Argus' } = Astro.props;
const path = Astro.url.pathname;
const onAgentPage = path.startsWith('/agents/');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <link rel="stylesheet" href="/styles/global.css" />
</head>
<body>
  <header class="app-header">
    <a href="/" class="brand">ARGUS<span class="dot">●</span></a>
    <nav class="app-nav">
      <a href="/" class={path === '/' ? 'active' : ''}>Overview</a>
      <a href="/sessions" class={path.startsWith('/sessions') || path === '/session' ? 'active' : ''}>Sessions</a>
      <a href="/tools" class={path === '/tools' ? 'active' : ''}>Tools</a>
      <a href="/trends" class={path === '/trends' ? 'active' : ''}>Trends</a>
      <a href="/models" class={path === '/models' ? 'active' : ''}>Models</a>
      <a href="/prompts" class={path === '/prompts' ? 'active' : ''}>Prompts</a>
      <a href="/settings" class={path === '/settings' ? 'active' : ''}>Settings</a>
    </nav>
    <div class="agent-picker-wrapper" id="agent-picker-wrapper" data-on-agent-page={onAgentPage ? '1' : '0'}>
      <button class="agent-picker-toggle" id="agent-picker-toggle" aria-haspopup="listbox" aria-expanded="false">
        <span class="agent-picker-label" id="agent-picker-label">Agent: All</span>
        <span class="caret">▾</span>
      </button>
      <div class="agent-picker-menu" id="agent-picker-menu" hidden>
        <div class="agent-picker-loading">Loading…</div>
      </div>
    </div>
  </header>
  <main><slot /></main>
  <footer class="app-footer" id="footer">
    <span class="status-pill" id="ingest-status">Loading…</span>
    <span style="margin: 0 0.8rem;">·</span>
    <span id="filter-label"></span>
    <span style="margin: 0 0.8rem;">·</span>
    <span id="pricing-info">Pricing —</span>
  </footer>
  <script>
    import { getFilter, setFilter, loadAgents } from '../scripts/agents';

    // ─── Status footer (existing behavior) ───────────────────────────
    async function refreshStatus() {
      try {
        const [p, s] = await Promise.all([
          fetch('/api/pricing').then(r => r.json()),
          fetch('/api/ingest/status').then(r => r.json()),
        ]);
        const pf = document.getElementById('pricing-info');
        if (pf) pf.innerHTML = `Costs estimated from pricing table v<code>${p.version}</code> — tokens are exact; <code>argus pricing refresh</code> to update`;
        const ip = document.getElementById('ingest-status');
        if (ip) {
          if (s.foregroundComplete && s.pending === 0) {
            const n = typeof s.sessionCount === 'number' ? s.sessionCount : s.processed;
            ip.textContent = `Tracking ${n} sessions`;
            ip.classList.remove('busy');
          } else if (!s.foregroundComplete) {
            ip.textContent = `Ingesting recent... ${s.processed}/${s.total}`;
            ip.classList.add('busy');
          } else {
            ip.textContent = `Backfilling history... ${s.processed}/${s.total}`;
            ip.classList.add('busy');
          }
        }
      } catch (e) { /* server may not be live yet */ }
    }
    refreshStatus();
    setInterval(refreshStatus, 4000);

    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }

    // ─── Agent picker (global filter) ─────────────────────────────────
    const wrapper = document.getElementById('agent-picker-wrapper');
    const onAgentPage = wrapper && wrapper.getAttribute('data-on-agent-page') === '1';
    if (onAgentPage && wrapper) {
      // On per-agent pages, the page is inherently scoped; the picker would mislead.
      wrapper.hidden = true;
    }

    function describeFilter(f, agentsById) {
      if (!f.agent && !f.backendAgent) return 'All';
      const display = agentsById[f.agent]?.display_name ?? f.agent;
      return f.backendAgent ? `${display} / ${f.backendAgent}` : display;
    }

    async function renderPicker() {
      const toggle = document.getElementById('agent-picker-toggle');
      const menu = document.getElementById('agent-picker-menu');
      const label = document.getElementById('agent-picker-label');
      const filterLabel = document.getElementById('filter-label');
      if (!toggle || !menu || !label) return;
      let agents = [];
      try { agents = await loadAgents(); } catch { /* keep empty */ }
      const agentsById = Object.fromEntries(agents.map(a => [a.name, a]));
      const f = getFilter();
      const desc = describeFilter(f, agentsById);
      label.textContent = `Agent: ${desc}`;
      if (filterLabel) {
        filterLabel.innerHTML = (f.agent || f.backendAgent)
          ? `filtered: <strong>${escapeHtml(desc)}</strong>`
          : '';
      }

      // Build menu items: "All" + each agent + each agent's backend_agents.
      const items = [];
      items.push({ label: 'All', value: {} });
      for (const a of agents) {
        items.push({ label: a.display_name, value: { agent: a.name } });
        if (Array.isArray(a.backend_agents) && a.backend_agents.length) {
          for (const b of a.backend_agents) {
            items.push({ label: `↳ ${b}`, value: { agent: a.name, backendAgent: b }, indented: true });
          }
        }
      }
      menu.innerHTML = items.map((it, i) => {
        const active = (it.value.agent ?? null) === (f.agent ?? null)
          && (it.value.backendAgent ?? null) === (f.backendAgent ?? null);
        return `<button class="agent-picker-option ${it.indented ? 'indented' : ''} ${active ? 'active' : ''}" data-idx="${i}">${escapeHtml(it.label)}</button>`;
      }).join('');
      menu.querySelectorAll('button.agent-picker-option').forEach(btn => {
        btn.addEventListener('click', () => {
          const idx = Number(btn.getAttribute('data-idx'));
          setFilter(items[idx].value);
          menu.hidden = true;
          toggle.setAttribute('aria-expanded', 'false');
        });
      });
    }
    renderPicker();

    const pickerToggle = document.getElementById('agent-picker-toggle');
    const pickerMenu = document.getElementById('agent-picker-menu');
    if (pickerToggle && pickerMenu) {
      pickerToggle.addEventListener('click', (e) => {
        // Without stopPropagation, the document handler below fires on the
        // same click — and because `e.target` is usually an inner span
        // (the "Agent: All" label or "▾" caret), the doc handler would
        // see it as "outside the toggle" and slam the menu closed in the
        // same tick we tried to open it.
        e.stopPropagation();
        const isHidden = pickerMenu.hidden;
        pickerMenu.hidden = !isHidden;
        pickerToggle.setAttribute('aria-expanded', String(isHidden));
      });
      document.addEventListener('click', (e) => {
        const target = e.target;
        // Use .contains so child spans of the button (and child elements
        // inside the menu) are correctly attributed to their parent.
        if (target instanceof Node && !pickerMenu.contains(target) && !pickerToggle.contains(target)) {
          pickerMenu.hidden = true;
          pickerToggle.setAttribute('aria-expanded', 'false');
        }
      });
    }

    // When the filter changes, re-render the label + tell every page to refresh.
    window.addEventListener('argus:filter-changed', () => { renderPicker(); });
  </script>
</body>
</html>
