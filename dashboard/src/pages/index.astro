---
import Default from '../layouts/Default.astro';
---
<Default title="Argus — Overview">
  <section class="hero">
    <div class="hero-controls">
      <select id="window">
        <option value="today">Today</option>
        <option value="7d" selected>Last 7 days</option>
        <option value="30d">Last 30 days</option>
        <option value="all">All time</option>
      </select>
    </div>
    <div class="hero-box">
      <div class="hero-tokens"><span class="skel" style="width:5em;height:1em;"></span></div>
      <div class="hero-tokens-label">tokens</div>
    </div>
    <p class="hero-sub">
      <span class="est-note">~<span id="hero-cost">—</span> estimated</span>
      <span style="margin: 0 0.6em; color: var(--text-2);">·</span>
      <strong id="hero-sessions">—</strong> sessions
      <span id="hero-avg" style="margin-left:0.6em; color:var(--text-2);"></span>
    </p>
  </section>

  <div class="card" id="alerts-card" style="display:none; margin-bottom:1.2rem;">
    <h3>What needs attention</h3>
    <div id="alerts-body"></div>
  </div>

  <div class="card" style="margin-bottom:1.2rem;">
    <h3>Tokens over time</h3>
    <div id="line" class="chart"></div>
  </div>

  <div class="grid-2">
    <div class="card">
      <h3>Daily heatmap (last 90 days)</h3>
      <div id="heatmap" class="chart"></div>
    </div>
    <div class="card">
      <h3>Top models by tokens (window)</h3>
      <div id="models" class="chart"></div>
    </div>
  </div>

  <div class="card" style="margin-top:1.2rem;">
    <h3>Top sessions in window</h3>
    <div id="recent"></div>
  </div>

  <script>
    import { api } from '../scripts/api';
    import { usd, tok, num, shortDate, shortPath, escapeHtml } from '../scripts/format';
    import { lineTokens, calendarHeatmap, modelMix } from '../scripts/charts';
    import { renderAlertCard, startNotificationPoll } from '../scripts/alerts';

    const $ = (s: string) => document.querySelector(s) as HTMLElement;
    const sel = $('#window') as HTMLSelectElement;

    let lineChart: any, heatChart: any, modelsChart: any;

    async function refresh() {
      const window = sel.value;
      // Single source of truth — /api/overview now returns top_sessions
      // and cost_by_model bucketed to the window, so we no longer fetch
      // every session and client-side filter (which dropped resumed
      // sessions and showed lifetime totals instead of window totals).
      const overview = await api.overview(window);

      $('.hero-tokens')!.textContent = tok(overview.total_tokens);
      $('#hero-cost')!.textContent = usd(overview.total_cost_usd);
      $('#hero-sessions')!.textContent = num(overview.session_count);
      const avgTok = overview.session_count ? Math.round(overview.total_tokens / overview.session_count) : 0;
      $('#hero-avg')!.textContent = overview.session_count ? `· ${tok(avgTok)} tok/session` : '';

      const days = Object.entries(overview.tokens_by_day).sort().map(([day, value]) => ({ day, value: value as number }));
      lineChart?.dispose();
      if (days.length) lineChart = lineTokens($('#line'), days);
      else $('#line').innerHTML = '<p class="empty">No activity in this window.</p>';

      const allOv = window === 'all' ? overview : await api.overview('all');
      const allDays = Object.entries(allOv.tokens_by_day).sort().map(([day, value]) => ({ day, value: value as number }));
      heatChart?.dispose();
      heatChart = calendarHeatmap($('#heatmap'), allDays, 90);

      // Models chart: read tokens_by_model from /api/overview (window-bucketed).
      const modelsList = Object.entries(overview.tokens_by_model ?? {})
        .sort((a, b) => (b[1] as number) - (a[1] as number))
        .map(([name, value]) => ({ name, value: value as number }));
      modelsChart?.dispose();
      if (modelsList.length) modelsChart = modelMix($('#models'), modelsList);
      else $('#models').innerHTML = '<p class="empty">No data.</p>';

      // Top sessions in window. Each row's tokens/cost is what the session
      // contributed in this window — summed across rows it equals the hero.
      // "Started" column is still the session's actual start date so a
      // resumed older session reads as "started May 9" even when shown
      // under "Today". The "+N days" tag flags multi-day sessions.
      const topSessions = (overview.top_sessions ?? []).slice(0, 8);
      $('#recent').innerHTML = topSessions.length ? `
        <table>
          <thead><tr><th>Started</th><th>Project</th><th>Model</th><th class="num">Tokens <span class="est">(in window)</span></th><th class="num">Cost <span class="est">(in window)</span></th></tr></thead>
          <tbody>
            ${topSessions.map((s: any) => `
              <tr data-id="${encodeURIComponent(s.id)}">
                <td>${shortDate(s.started_at)}${s.days_active > 1 ? ` <span style="color:var(--text-2);font-size:0.75rem;">+${s.days_active - 1}d</span>` : ''}</td>
                <td class="mono">${escapeHtml(shortPath(s.project_path))}</td>
                <td><code>${escapeHtml(s.primary_model)}</code></td>
                <td class="num tok">${tok(s.window_tokens)}</td>
                <td class="num cost">~${usd(s.window_cost_usd)}</td>
              </tr>
            `).join('')}
          </tbody>
        </table>` : '<p class="empty">No sessions in this window.</p>';
      $('#recent').querySelectorAll('tr[data-id]').forEach(tr => {
        tr.addEventListener('click', () => location.href = '/session?id=' + (tr as HTMLElement).dataset.id);
      });
    }

    sel.addEventListener('change', refresh);
    refresh();
    window.addEventListener('resize', () => [lineChart, heatChart, modelsChart].forEach(c => c?.resize()));

    const alertsBody = $('#alerts-body');
    renderAlertCard(alertsBody);
    startNotificationPoll(alertsBody);
  </script>
</Default>
