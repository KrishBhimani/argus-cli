---
import Default from '../layouts/Default.astro';
---
<Default title="Argus — Compare">
  <h2>Compare agents</h2>
  <div class="card" style="margin-bottom:1rem;display:flex;gap:0.6rem;align-items:center;">
    <label style="color:var(--text-2);font-size:0.8rem;">Window</label>
    <select id="w"><option value="7d">7d</option><option value="30d" selected>30d</option><option value="all">All time</option></select>
  </div>
  <div class="grid-2" id="cards"></div>
  <p class="disclaimer">
    OpenAI caches prompts automatically and does not bill or report cache writes, so OpenAI sessions show 0 cache writes.
    Cache hits are also not directly comparable: OpenAI's automatic cache makes hits common and incidental,
    while Anthropic's hits reflect intentional <code>cache_control</code> placement.
  </p>

  <script>
    import { api, type Session } from '../scripts/api';
    import { usd, tok, num } from '../scripts/format';

    const $ = (s: string) => document.querySelector(s) as HTMLElement;
    const w = $('#w') as HTMLSelectElement;

    function bar(left: number, right: number, label: string, fmt: (n: number) => string) {
      const max = Math.max(left, right, 0.0001);
      return `<tr>
        <td style="width:30%;color:var(--text-2);font-size:0.78rem;text-transform:uppercase;letter-spacing:0.04em;">${label}</td>
        <td style="text-align:right;font-variant-numeric:tabular-nums;width:30%;">${fmt(left)}</td>
        <td style="width:40%;padding:0;">
          <div style="display:flex;height:8px;border-radius:4px;overflow:hidden;background:var(--bg-2);">
            <div style="background:var(--claude);width:${(left / max) * 50}%;"></div>
            <div style="width:0.5px;background:var(--border);"></div>
            <div style="background:var(--codex);width:${(right / max) * 50}%;"></div>
          </div>
        </td>
        <td style="text-align:left;font-variant-numeric:tabular-nums;width:20%;padding-left:0.6rem;">${fmt(right)}</td>
      </tr>`;
    }

    async function refresh() {
      const ov = await api.overview(w.value);
      const all = (await api.sessions('?limit=100000')).sessions as Session[];
      const cutoff = w.value === '7d' ? Date.now() - 7 * 86400000 : w.value === '30d' ? Date.now() - 30 * 86400000 : 0;
      const sessions = all.filter(s => new Date(s.started_at).getTime() >= cutoff);
      const c = ov.agent_split.claude_code ?? { cost: 0, sessions: 0, tokens: 0 };
      const x = ov.agent_split.codex ?? { cost: 0, sessions: 0, tokens: 0 };
      const cAvg = c.sessions ? c.cost / c.sessions : 0;
      const xAvg = x.sessions ? x.cost / x.sessions : 0;
      const cTokRate = c.cost > 0 ? c.tokens / c.cost : 0;
      const xTokRate = x.cost > 0 ? x.tokens / x.cost : 0;
      const cClaude = sessions.filter(s => s.agent === 'claude_code');
      const cCodex = sessions.filter(s => s.agent === 'codex');
      const claudeModels = [...new Set(cClaude.map(s => s.primary_model))];
      const codexModels = [...new Set(cCodex.map(s => s.primary_model))];

      $('#cards').innerHTML = `
        <div class="card">
          <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:0.6rem;">
            <h3 style="margin:0;color:var(--claude);font-size:1rem;">CLAUDE CODE</h3>
            <span style="color:var(--text-2);font-size:0.75rem;">${num(c.sessions)} sessions</span>
          </div>
          <div class="kpi-value cost" style="font-size:2.4rem;">${usd(c.cost)}</div>
          <div style="color:var(--text-1);font-size:0.85rem;margin-top:0.2rem;">${tok(c.tokens)} tokens</div>
          <div style="margin-top:1rem;font-size:0.85rem;color:var(--text-2);">
            Models used: ${claudeModels.length ? claudeModels.map(m => `<code>${m}</code>`).join(' ') : '—'}
          </div>
        </div>
        <div class="card">
          <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:0.6rem;">
            <h3 style="margin:0;color:var(--codex);font-size:1rem;">CODEX</h3>
            <span style="color:var(--text-2);font-size:0.75rem;">${num(x.sessions)} sessions</span>
          </div>
          <div class="kpi-value cost" style="font-size:2.4rem;color:var(--codex);">${usd(x.cost)}</div>
          <div style="color:var(--text-1);font-size:0.85rem;margin-top:0.2rem;">${tok(x.tokens)} tokens</div>
          <div style="margin-top:1rem;font-size:0.85rem;color:var(--text-2);">
            Models used: ${codexModels.length ? codexModels.map(m => `<code>${m}</code>`).join(' ') : '—'}
          </div>
        </div>
      `;

      const breakdownCard = document.createElement('div');
      breakdownCard.className = 'card';
      breakdownCard.style.gridColumn = '1 / -1';
      breakdownCard.style.marginTop = '0';
      breakdownCard.innerHTML = `
        <h3 style="margin-bottom:0.8rem;">Side-by-side</h3>
        <table style="border:none;">
          <thead><tr>
            <th></th>
            <th style="text-align:right;color:var(--claude);">Claude</th>
            <th></th>
            <th style="text-align:left;color:var(--codex);padding-left:0.6rem;">Codex</th>
          </tr></thead>
          <tbody>
            ${bar(c.cost, x.cost, 'Total cost', usd)}
            ${bar(c.sessions, x.sessions, 'Sessions', num)}
            ${bar(c.tokens, x.tokens, 'Tokens', tok)}
            ${bar(cAvg, xAvg, 'Avg cost / session', usd)}
            ${bar(cTokRate, xTokRate, 'Tokens per $1', (n: number) => tok(Math.round(n)))}
          </tbody>
        </table>
      `;
      $('#cards').appendChild(breakdownCard);
    }
    w.addEventListener('change', refresh);
    refresh();
  </script>
</Default>
