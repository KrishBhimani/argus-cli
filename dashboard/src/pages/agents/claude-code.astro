---
import Default from '../../layouts/Default.astro';
---
<Default title="Claude Code — Argus">
  <h1 style="margin-bottom: 0.4rem;">Claude Code</h1>
  <p class="muted" id="cc-summary" style="margin: 0 0 1.5rem; color: var(--text-2);">Loading…</p>

  <section class="card">
    <header class="card-header">
      <h2>Sub-agents (Task tool delegations)</h2>
      <label>Window
        <select id="cc-window">
          <option value="today">today</option>
          <option value="7d" selected>7d</option>
          <option value="30d">30d</option>
          <option value="all">all</option>
        </select>
      </label>
    </header>
    <table class="data-table">
      <thead><tr><th>Type</th><th class="num">Invocations</th><th class="num">Errors</th><th class="num">Error rate</th></tr></thead>
      <tbody id="cc-subagents"><tr><td colspan="4" class="muted">Loading…</td></tr></tbody>
    </table>
  </section>

  <section class="card" style="margin-top: 1.5rem;">
    <header class="card-header"><h2>More widgets coming</h2></header>
    <p class="muted" style="padding: 0 1rem 1rem;">Reserved space for file-history hotspots, skills inventory, and other Claude-Code-specific views. See <code>docs/feature-backlog.md</code>.</p>
  </section>

  <script type="module">
    import { num as fmtNum } from '/scripts/format.js';

    const windowSel = document.getElementById('cc-window');
    const body = document.getElementById('cc-subagents');
    const summary = document.getElementById('cc-summary');

    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }

    async function refresh() {
      const w = windowSel.value;
      const r = await fetch('/api/agents/claude-code/sub-agents?window=' + w).then(r => r.json());
      if (!r.sub_agents || r.sub_agents.length === 0) {
        body.innerHTML = '<tr><td colspan="4" class="muted">No sub-agent invocations in this window.</td></tr>';
      } else {
        body.innerHTML = r.sub_agents.map(s => `
          <tr>
            <td>${escapeHtml(s.type)}</td>
            <td class="num">${fmtNum(s.invocations)}</td>
            <td class="num">${fmtNum(s.errors)}</td>
            <td class="num">${(s.error_rate * 100).toFixed(1)}%</td>
          </tr>`).join('');
      }
      const total = (r.sub_agents ?? []).reduce((a, x) => a + x.invocations, 0);
      summary.textContent = `Last ${w} · ${fmtNum(total)} sub-agent invocations`;
    }
    windowSel.addEventListener('change', refresh);
    refresh();
  </script>
</Default>
